# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。

# 阿里云百炼（DashScope）：只填这一个就能跑完整条流程
#   转写：Paraformer（词级时间戳）
#   翻译与难点表达：百炼 OpenAI 兼容模式
#   申请：https://bailian.console.aliyun.com/  （国际站同样可用）
DASHSCOPE_API_KEY=

# 可选：任意 OpenAI 兼容端点，优先于 DashScope 用于翻译与难点表达
#   例：DeepSeek 官方 https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_API_KEY=
# 可选：模型名，默认 deepseek-v4.1-flash
LLM_MODEL=

# 可选：备用翻译供应商（失败时自动切换）
OLLAMA_API_KEY=
OPENCODE_API_KEY=
