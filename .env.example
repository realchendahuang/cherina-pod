# 阿里云百炼 DashScope（Paraformer ASR 转写）
DASHSCOPE_API_KEY=

# DeepSeek V4 Flash 双供应商（翻译，任填其一即可，两个都填可负载均衡）
OLLAMA_API_KEY=
OPENCODE_API_KEY=

# 自建音频源（docs/音频存储方案.md）：主端点走公网（CF 边缘，不依赖本机 Tailscale），兜底走 tailnet 内网
RUSTFS_ENDPOINT=https://pod-audio.cherina.app/s3
RUSTFS_ENDPOINT_FALLBACK=http://<TAILNET_IP>:9200
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=cherina-pod-audio
