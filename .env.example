# 转写（ASR）：阿里云百炼 DashScope Paraformer
#   不想用云服务的话，whisper 本地转写尚未内置（见 README「待补」）
DASHSCOPE_API_KEY=

# 翻译：OpenAI 兼容端点，任填其一即可，两个都填会负载均衡
#   也可填任何 OpenAI 兼容服务（改 scripts/translate.py 里的 base URL）
OLLAMA_API_KEY=
OPENCODE_API_KEY=

# ── 以下为可选的自建音频源（docs/音频存储方案.md）────────────────────────────────
# 不填也能跑：播放器会自动走 RSS 外链。填了就用你自己的 S3 兼容存储（RustFS / MinIO），
# 好处是音文绝对对齐（与转写同一份文件），避开托管商动态插广告导致的时间轴漂移。
# 注意：这是**你自己的**实例，示例里不要填别人的地址。
RUSTFS_ENDPOINT=https://your-audio-cdn.example.com/s3
RUSTFS_ENDPOINT_FALLBACK=http://<YOUR_PRIVATE_ENDPOINT>:9200
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=your-pod-audio
